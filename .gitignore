#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

.prompt_attachments
*.hologram.dart
node_modules/
functions/lib/supabase/.temp/

supabase/.temp/

# Playwright MCP scratch: screenshots and console logs from browser
# verification runs. Useful while debugging, never part of the app.
.playwright-mcp/

# The SQL tests pull Postgres-compiled-to-WASM down as a dev dependency.
tool/sql/node_modules/

# Vercel build output. Same source as docs/, different base path; rebuilt
# by tool/build_vercel.ps1 whenever it is deployed.
.vercel-out/
.vercel/

# Blender render frames. Re-created by rendering site/art/paper-stack.blend;
# only the encoded video and stills in site/public/art/ are shipped.
.render/

# Local preview build of the app (served on :3000). Rebuilt by
# tool/build_web.ps1 -BasePath / -OutDir .local-web; never shipped from git.
.local-web/
