# Secrets for the edge functions. Copy to supabase/functions/.env (gitignored),
# fill in, then upload:
#
#   npx supabase secrets set --env-file supabase/functions/.env --project-ref <ref>
#
# See "Server-side secrets" in README.md for what each one does.

# --- Required ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# --- Optional: cheaper model routes ---
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=
DEEPSEEK_API_KEY=
KIMI_MODEL=
KIMI_KEYLESS=
MOONSHOT_API_KEY=
KIMI_ALLOW_MOONSHOT=

# --- Optional: RevenueCat ---
# true lets sandbox and Test Store purchases change a plan (off by default).
REVENUECAT_ACCEPT_SANDBOX=

# --- Optional: Stripe web checkout (not configured by default) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_ORIGIN=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_SCHOOL=

# --- Optional: OneSignal push from OVERNIGHT-SWEEPER (not configured by default) ---
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- Optional: internal testing and admin ---
# Comma-separated. Accounts here get the internal `preview` plan.
FOUNDER_EMAILS=
FOUNDER_TEACHER_IDS=
ADMIN_STATS_KEY=

# Provided by Supabase automatically; do not set:
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_DB_URL
