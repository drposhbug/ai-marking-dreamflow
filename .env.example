# Build-time settings for the Flutter app. Every value here is public by
# design (it ships inside the app), but keep your filled-in copy in .env,
# which is gitignored.
#
#   cp .env.example .env
#   flutter run --dart-define-from-file=.env
#
# Leave a value empty to switch that feature off; see "Build and run" in
# README.md for what each one does when absent.

# Your Supabase project. Set both, or leave both empty to run local-only
# (nothing is marked). An empty line still counts as "set", so do not fill in
# the anon key and leave the URL blank.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (goog_... and appl_...).
REVENUECAT_ANDROID_KEY=
REVENUECAT_IOS_KEY=

# Optional: OneSignal push.
ONESIGNAL_APP_ID=
